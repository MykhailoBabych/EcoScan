# ─── EcoScan environment variables ──────────────────────────────────────────
# Copy this file to ".env" and fill in real values:
#   cp .env.example .env        (macOS/Linux)
#   Copy-Item .env.example .env (Windows PowerShell)
#
# Every variable is prefixed with EXPO_PUBLIC_ so Expo inlines it into the app
# at build time.
#
# SECURITY NOTE: EXPO_PUBLIC_ values are embedded in the client bundle and are
# therefore readable by anyone who inspects the shipped app. They are kept out
# of source control (see .gitignore) so they are not leaked in the repo, but for
# a production release you should proxy the Google API calls through a backend
# (e.g. a Supabase Edge Function) and restrict each key in its provider console.

# Supabase project — Project Settings → API
EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Google Cloud Vision API key — used by the Scanner screen.
# Restrict this key to the Vision API (and your app) in the Google Cloud Console.
EXPO_PUBLIC_VISION_API_KEY=your-google-vision-api-key

# Google Gemini API key — used for AI upcycling ideas.
# Optional: the app falls back to built-in suggestions when this is not set.
EXPO_PUBLIC_GEMINI_API_KEY=your-gemini-api-key
